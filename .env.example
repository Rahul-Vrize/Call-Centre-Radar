# --- Transcription provider ---
# assemblyai (primary, spends the free credit) | whisper (offline fallback)
TRANSCRIBER_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=

# faster-whisper settings, used when TRANSCRIBER_PROVIDER=whisper
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Local LLM (reasoning layer: intent / resolution / summary / attention) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# --- Storage ---
DATABASE_PATH=./data/radar.db
DATA_DIR=./data

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Evidence verification ---
EVIDENCE_MATCH_THRESHOLD=85
